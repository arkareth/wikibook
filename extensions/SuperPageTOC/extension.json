{
  "name": "SuperPageTOC",
  "version": "1.0.0",
  "author": [
    "Sergey Menshikov"
  ],
  "url": "https://www.mediawiki.org/wiki/Extension:BoilerPlate",
  "license-name": "MIT",
  "type": "other",
  "MessagesDirs": {
    "SuperPageTOC": [
      "i18n"
    ]
  },
  "AutoloadClasses": {
    "SuperPageTOC": "SuperPageTOC.class.php"
  },
  "Hooks": {
    "BeforePageDisplay": "SuperPageTOC::onBeforePageDisplay",
    "ParserAfterParse": "SuperPageTOC::onParserAfterParse",
    "ParserBeforeInternalParse": "SuperPageTOC::onParserBeforeStrip"
  },
  "ResourceModules": {
    "ext.superpagetoc.styles": {
      "localBasePath": "resources",
      "remoteExtPath": "SuperPageTOC/resources",
      "styles": [
        "superpagetoc-tweeki.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "ext.superpagetoc.tweeki": {
      "localBasePath": "resources",
      "remoteExtPath": "SuperPageTOC/resources",
      "scripts": [
        "superpagetoc-tweeki.js"
      ],
      "dependencies": [
        "jquery"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    }
  },
  "manifest_version": 1
}